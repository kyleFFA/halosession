<Project>
	<PropertyGroup>
		<!-- Short per-project dependency paths avoid MSVC/CMake's path limit. -->
		<VcpkgInstalledDir>$(LocalAppData)\HaloPracticeBuild\$(MSBuildProjectName)\</VcpkgInstalledDir>
		<OutputPath_Global>__UNDEFINED__</OutputPath_Global>
		<OutputPath_Global Condition="Exists('$(SolutionDir)OutputPath.vsmacro')">"$([System.IO.File]::ReadAllText('$(SolutionDir)OutputPath.vsmacro').trim())"</OutputPath_Global>
		<VersionPrefix>3.1.9.0</VersionPrefix>
</PropertyGroup>
</Project>
